# MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/crm
PORT=3000

# Gmail SMTP for the email module (POST /email/send).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# OpenAI key for the AI module.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI-compatible base URL. Set to use OpenRouter (so an
# OpenRouter key in OPENAI_API_KEY works): https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# Keep-alive (Render free tier): optional. Render sets RENDER_EXTERNAL_URL itself; set this only to override.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_SECONDS=300
